# =============================================================================
# Trunkline - AI Model Service Routing Gateway
# Git Ignore Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Build Outputs
# -----------------------------------------------------------------------------
target/
!**/src/main/**/target/
!**/src/test/**/target/

# Maven Wrapper
!.mvn/wrapper/maven-wrapper.jar

# -----------------------------------------------------------------------------
# IDE & Editor
# -----------------------------------------------------------------------------
# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
.idea/modules.xml
.idea/jarRepositories.xml
.idea/compiler.xml
.idea/libraries/

# Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# VS Code
.vscode/

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# Kiro (AI IDE)
.kiro/

# -----------------------------------------------------------------------------
# Frontend (Vue 3)
# -----------------------------------------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.temp/
frontend/.cache/
frontend/*.local
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*

# Auto-generated TypeScript declarations
frontend/auto-imports.d.ts
frontend/components.d.ts

# Frontend runtime directories
frontend/config/
frontend/config-store/
frontend/logs/

# -----------------------------------------------------------------------------
# Database & Data Files
# -----------------------------------------------------------------------------
# H2 Database files
data/
# v0.2.0 内置模型画像需随包发布，不能被上面的 data/ 规则吞掉
!src/main/resources/data/
!src/main/resources/data/*.json
*.db
*.mv.db
*.trace.db
*.lock.db
data/*.mv.db
data/*.trace.db
data/*.lock.db

# R2DBC temp directory
r2dbc:h2:file/

# -----------------------------------------------------------------------------
# Logs & Runtime
# -----------------------------------------------------------------------------
logs/
*.log
app.log
application.log

# -----------------------------------------------------------------------------
# Docker (local scratch)
# -----------------------------------------------------------------------------
# Local docker build context / scratch dir created by the docker workflows.
# Docker contexts can hold registry credentials, so keep it out of the repo.
docker-ctx/

# -----------------------------------------------------------------------------
# Configuration (Runtime Generated)
# -----------------------------------------------------------------------------
# Runtime config directories (keep templates)
# 忽略 config/ 内容本身，但保留下列显式豁免文件（/config/ 整体忽略会让 !config/xxx 失效）
/config/*
config-dev/
config-store/

# Allow source code config directories
!src/**/config/

# Environment files (keep .env.example)
.env
.env.local
.env.*.local

# Runtime generated properties
.trunkline-data-dir.properties

# -----------------------------------------------------------------------------
# Documentation & Static Content
# -----------------------------------------------------------------------------
# Internal documentation (not for public)
innerdoc/

# Root-level generated / internal summary docs — live under innerdoc/, not the repo root.
# CI docs-version-management generates docs-version-report.md at root for artifacts/issues only.
/docs-version-report.md
/docs-version-data.json
/docs-version-data.csv
/outdated-check.txt
/merge-log-*.md
/repository-description.md
/release-notes-*.md
# Internal planning page (not the product SPA, which is frontend/index.html)
/index.html

# Site build output
site/

# Capture/screenshots directory (root level only)
/capture/

# Frontend build output — generated at build time (pom copies frontend/dist → static/admin).
# Never commit these: stale copies silently shadow real builds and can ship the SPA at the
# wrong path (see issue #48).
src/main/resources/static/

# -----------------------------------------------------------------------------
# Monitoring & Observability
# -----------------------------------------------------------------------------
monitoring/prometheus/data/
monitoring/grafana/data/
monitoring/alertmanager/data/

# -----------------------------------------------------------------------------
# OS & System Files
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# -----------------------------------------------------------------------------
# Miscellaneous
# -----------------------------------------------------------------------------
# Temporary files
*.tmp
*.temp
*.swp
*.swo
*.bak
*.backup
*.orig

# jpackage 桌面版打包暂存目录（宽模块 runtime 暂存以避开 mvn clean，用完移回 target/）
# 结尾是 -bak 而非 .bak，不会被上面的 *.bak 命中，需显式声明
.packager-runtime-bak/
.build-stash/
build-stash/

# Archive files (usually downloaded dependencies)
*.zip
*.tar.gz
*.rar
*.7z

# Scripts temp directory (legacy, should not exist)

# Qwen Code working directory (keep QWEN.md and PROJECT_SUMMARY.md)
.qwen/settings.json
.qwen/settings.json.orig
.qwen/output-language.md

# Test coverage reports (generated by CI)
coverage/
.nyc_output/

# Dependency directories (if using jdeps)
jdeps/

# -----------------------------------------------------------------------------
# Keep Important Files (Exceptions)
# -----------------------------------------------------------------------------
# Keep configuration templates
!config/*.example
!config/*.template
!config/*.yml.example
!config/suppressions.xml
!config/redis.conf

# Keep branding assets
!logo/

# Keep scripts (organized by function)
!scripts/build/
!scripts/dev/
!scripts/migration/
!scripts/monitoring/
!scripts/test/
!scripts/tools/
# Qwen Code temporary files
.qwen/skills/
.qwen/welcome-back-state.json
link-check-report.json
.codegraph/

# MiMo Code agent metadata
.mimocode/

# Agent skills (project-specific, not for git)
.agents/skills/

# JCodeIndexer data
.jindexer/

# Local build/quality snapshots (not for git)
checkstyle-*.txt
compile-result.txt
jindexer.jar

# playwright-cli 临时产物
.playwright-cli/

# WorkBuddy 项目数据（会话记录等，不进 git）
.workbuddy/

# 前端 e2e 临时截图
frontend/.e2e_shots_*/

# 退役代码归档（保留本地参考，不进 git）
frontend/src/views/_attic/

# 一次性诊断脚本与浏览器快照（生成后不进 git）
/wizard-*.yaml
frontend/diag/
frontend/diag-pages/

# GitHub 平台配置：同步用的 SSH 密钥等本地敏感文件不进 git，
# 但 workflows（CI 门禁、镜像同步脚本）必须随代码版本化，否则打 tag 无回归护栏。
.github/*
!.github/workflows/
.github/workflows/*
!.github/workflows/*.yml
__pycache__/
